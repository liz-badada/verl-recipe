# Mirrors uni-agent's official CI (.github/workflows/ci.yml): Python 3.12,
# requirements-test.txt, SWE-bench v4.1.0 from source, then
# `pytest tests/uni_agent/ -m "cpu and level0"`.
#
# Deps are baked in; the repo is bind-mounted at /workspace at run time, so the
# editable installs resolve against the live working tree and code edits need no
# rebuild.
FROM python:3.12-slim

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends git build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Copy only what the dependency resolution needs, so edits to source do not
# invalidate this layer.
COPY requirements-test.txt /workspace/requirements-test.txt
COPY verl /workspace/verl

RUN python -m pip install --upgrade pip \
    && pip install -r requirements-test.txt \
    && pip install pytest pytest-cov

RUN git clone --depth 1 --branch v4.1.0 https://github.com/princeton-nlp/SWE-bench.git /opt/SWE-bench \
    && pip install -e /opt/SWE-bench

ENV PYTHONPATH=/workspace
