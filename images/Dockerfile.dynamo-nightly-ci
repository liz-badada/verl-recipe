# CPU image for running dynamo main's Python components (thunderagent_router,
# mocker, frontend) against the matching nightly ai-dynamo wheel.
#
# The nightly wheel's _core links against dynamo's own FFmpeg build, whose
# SONAMEs carry --build-suffix=_dynamo (libavutil_dynamo.so.61, ...). No distro
# ships those, so build the same FFmpeg version (context.yaml: 9.0.1) with every
# codec disabled -- nothing here decodes media.
FROM uni-agent-ci:py312

ARG FFMPEG_VERSION=9.0.1
ARG AI_DYNAMO_VERSION=1.6.0.dev20261009
ARG ETCD_VERSION=v3.5.21
ARG NATS_VERSION=v2.11.4

RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
        build-essential pkg-config xz-utils curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN cd /tmp && curl --retry 5 -LO https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz \
    && tar xf ffmpeg-${FFMPEG_VERSION}.tar.xz && cd ffmpeg-${FFMPEG_VERSION} \
    && ./configure --prefix=/usr/local --build-suffix=_dynamo --enable-shared --disable-static \
        --disable-everything --disable-programs --disable-doc --disable-x86asm --disable-network \
        --disable-gpl --disable-nonfree \
    && make -j"$(nproc)" >/dev/null && make install >/dev/null && ldconfig \
    && cd / && rm -rf /tmp/ffmpeg-${FFMPEG_VERSION}*

RUN cd /tmp \
    && curl --retry 5 -L https://github.com/etcd-io/etcd/releases/download/${ETCD_VERSION}/etcd-${ETCD_VERSION}-linux-amd64.tar.gz \
        | tar xz --strip-components=1 -C /usr/local/bin etcd-${ETCD_VERSION}-linux-amd64/etcd \
    && curl --retry 5 -L https://github.com/nats-io/nats-server/releases/download/${NATS_VERSION}/nats-server-${NATS_VERSION}-linux-amd64.tar.gz \
        | tar xz --strip-components=1 -C /usr/local/bin nats-server-${NATS_VERSION}-linux-amd64/nats-server

RUN pip install -q "ai-dynamo==${AI_DYNAMO_VERSION}" \
    && python -c "from dynamo.llm import AisPerfConfig; import dynamo.runtime; print('ai-dynamo', '${AI_DYNAMO_VERSION}', 'imports OK')"
